# --- secrets ---
backend/.env
*.key

# --- python ---
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- working data (regenerated by ingesting PDFs) ---
data/
*.db
*.db-wal
*.db-shm

# ...but the sample snapshot IS committed on purpose: it lets a reviewer open
# the full UI with no API key and no ingestion run. See samples/README.md.
!samples/facts.db

# --- node ---
frontend/node_modules/

# frontend/dist is deliberately committed. The backend serves it directly, so a
# reviewer needs only Python to run the whole app - no Node, no second terminal,
# no build step. `npm run dev` is still the way to work on the UI.

# --- editors / os ---
.DS_Store
Thumbs.db
.vscode/
.idea/
