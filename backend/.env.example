# Copy to backend/.env and fill in. Never commit the real .env.

# --- Gemini ---------------------------------------------------------------
# Comma-separated pool of free-tier keys. The server round-robins across them,
# rate-limits each one independently, and parks any key that returns 429 until
# its cooldown expires. One key works; more keys means more throughput.
GEMINI_API_KEYS=key_one,key_two,key_three

# Model names move fast - `python scripts/check_keys.py` will tell you if one is
# retired, and lists what your key can actually see.
#
# Extraction is high-volume and mechanical, so it runs on a fast model.
GEMINI_MODEL=gemini-3.5-flash-lite
# Judgment is lower-volume; this is the workhorse for it.
GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite
# Reserved for pairs where a contradiction is plausible (same period, values
# disagree). Stronger and slower, with a small free-tier daily allowance - the
# circuit breaker routes around it automatically once that is spent.
GEMINI_ESCALATION_MODEL=gemini-3.5-flash
# Retried onto this model late in the attempt budget. It has its own separate
# free-tier quota, so it is a real escape hatch when the main model is exhausted.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Stay under the free-tier per-key limit (~15 rpm for flash).
GEMINI_PER_KEY_RPM=10
GEMINI_MAX_ATTEMPTS=6
EXTRACTION_CONCURRENCY=3
# Soft guard against burning a whole day of free-tier quota in one ingest.
# Roughly (number of keys x per-key daily cap). Set 0 to disable.
DAILY_CALL_BUDGET=200

# --- chunking -------------------------------------------------------------
# The main quota dial: larger chunks mean fewer calls, at some cost to recall
# within a chunk. Citation precision is unaffected.
CHUNK_TARGET_CHARS=15000
CHUNK_MAX_CHARS=20000
MAX_FACTS_PER_CHUNK=40
EXTRACT_TABLES=true

# --- embeddings -----------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- linking --------------------------------------------------------------
SIMILARITY_THRESHOLD=0.58
MAX_CANDIDATES_PER_FACT=5
JUDGE_BATCH_SIZE=12
NUMERIC_TOLERANCE=0.005

# --- evidence -------------------------------------------------------------
QUOTE_MATCH_THRESHOLD=0.82

# --- security ---------------------------------------------------------------
# Unset by default: the app binds to localhost and is single-user, so a token
# would be friction with no benefit. Set it before exposing the app anywhere
# else, and every mutating endpoint then requires
# `Authorization: Bearer <token>`.
# API_TOKEN=

# Per-client request ceiling. Protects the process; the API bill is protected by
# DAILY_CALL_BUDGET and the key pool. 0 disables.
RATE_LIMIT_PER_MINUTE=120

# PDF parsing is unsandboxed, so a hostile file is bounded up front. The page
# count is checked before the document is walked.
MAX_UPLOAD_MB=25
MAX_PAGES_PER_UPLOAD=600
MAX_DOCUMENT_CHARS=12000000

# Serve what is already ingested and refuse new uploads entirely.
DEMO_MODE=false
